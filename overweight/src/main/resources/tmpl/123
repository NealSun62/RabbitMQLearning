public RpcResultDTO<PoolFlowStartResultVo> instBatchStart(PoolFlowParamVo poolFlowParamVo) {
PoolFlowStartResultVo poolFlowStartResultVo = new PoolFlowStartResultVo();
List<PoolContentInsertVo> failedResult = new ArrayList<>();
List<SuccessFlowInfo> successFlowInfos = new ArrayList<>();
String adjustFlowInitiator = poolFlowParamVo.getAdjustFlowInitiator();
String aprvEvt = poolFlowParamVo.getAprvEvt();
//分组
List<PoolContentInsertVo> poolContentInsertVos = poolFlowParamVo.getPoolContentInsertVos();
Map<String, List<PoolContentInsertVo>> adjustIn = poolContentInsertVos.stream().filter(item -> StringUtils.isNotEmpty(item.getAdjustInPoolUuid())).collect(Collectors.groupingBy(PoolContentInsertVo::getAdjustInPoolUuid));
Map<String, List<PoolContentInsertVo>> adjustOut = poolContentInsertVos.stream().filter(item -> StringUtils.isNotEmpty(item.getAdjustOutPoolUuid())).collect(Collectors.groupingBy(PoolContentInsertVo::getAdjustOutPoolUuid));
//根据池id查询债券池配置
List<String> poolUuidList = new ArrayList<>();
Set<String> inSet = adjustIn.keySet();
Set<String> outSet = adjustOut.keySet();
poolUuidList.addAll(inSet);
poolUuidList.addAll(outSet);
Example example = new Example(PoolAttribute.class);
// example.createCriteria().andIn(PoolAttribute.Fields.poolUuid,poolUuidList);
example.and(DatabaseUtil.sqlSpecialForIn(example, PoolAttribute.Fields.poolUuid, poolUuidList));
List<PoolAttribute> poolAttributes = poolAttributeDao.selectByExample(example);
//调入 分为有流程和无流程
if (CollectionUtils.isNotEmpty(inSet)) {
//有流程 根据流程种类发起流程，同一个流程只发起一个
List<PoolAttribute> inAttribute = poolAttributes.stream().filter(item -> inSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_OPEN.equals(item.getManualInApproveSwitch())).collect(Collectors.toList());
Map<String, List<PoolAttribute>> inFlowMap = inAttribute.stream().collect(Collectors.groupingBy(PoolAttribute::getManualInApproveFlowId));
Set<String> keySet = inFlowMap.keySet();
for (String processKey : keySet) {
try {
List<String> inFlowPool = inFlowMap.get(processKey).stream().map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> inFlowPool.contains(item.getAdjustInPoolUuid())).collect(Collectors.toList());
Map<String, Object> map = new HashMap<>();
//                map.put("hsBpmInstanceDesc", hsBpmInstanceDesc);
Map<String, String> mapScr = new HashMap<>();
mapScr.put("scr_name", "");
mapScr.put("ins_fn", poolFlowParamVo.getInsFn());
map.put("hsBpmInstanceExt", JSON.toJSONString(mapScr));
map.put("hsBpmRemark", aprvEvt);
map.put(WorkflowConstants.SUBMIT_USER, poolFlowParamVo.getAdjustFlowInitiator());
TSysUserBean tSysUserBean = new TSysUserBean();
tSysUserBean.setUserId(poolFlowParamVo.getAdjustFlowInitiator());
UserInfoBean userInfo = iUserService.getUserInfo(tSysUserBean);
if (Objects.nonNull(userInfo)) {
map.put(WorkflowConstants.SUBMIT_USER_ROLE, Joiner.on(Constants.SPLIT_TYPE).join(userInfo.getUserRoleList()
.stream().map(TSysRoleUser::getRoleCode).collect(Collectors.toSet())));
}
String outcome = null;
// 根据客户号进行不同处理
String custNum = configForCommService.getCustomNum().getResult();
if (Constants.FTS_CUSTNUM.equals(custNum)) {
outcome = "submit";
}
String instanceId = instanceService.startWithSubmit(systemId, companyId, adjustFlowInitiator, processKey, null, outcome, map, null);
//poolFlowParamVo 转化 PoolAdjustResultVO
List<PoolAdjustResultVO> poolAdjustResultVOS = this.copyData(insertPoolData, instanceId, poolFlowParamVo.getAdjustFlowInitiator());
createInstPoolAdjust(poolAdjustResultVOS, poolFlowParamVo.getAdjustFlowInitiator());
Long taskId = taskService.getLastTaskByInstanceId(systemId, companyId, instanceId);
SuccessFlowInfo successFlowInfo = new SuccessFlowInfo();
successFlowInfo.setFlowInstNo(instanceId);
successFlowInfo.setTaskNum(taskId.toString());
successFlowInfos.add(successFlowInfo);
//后端保存已办
// 机构池
String nodeId = Constants.SUBJECT_IN_START_NODE;
// 根据客户号进行不同处理
if (Constants.FTS_CUSTNUM.equals(custNum)) {
if (Constants.SUBJECT_IN_OUT_NODE_FTS_MAP.keySet().contains(processKey)) {
nodeId = Constants.SUBJECT_IN_OUT_NODE_FTS_MAP.get(processKey);
}
}
String startJson = this.buildInstInPoolStartPage(poolAdjustResultVOS, poolFlowParamVo.getAdjustFlowInitiator(), aprvEvt);
ratForCommService.saveTaskConentForComp(instanceId, taskId.toString(), startJson, nodeId);
} catch (Exception e) {
log.error("调入流程发起失败：" + e.getMessage());
List<String> inFlowPool = inFlowMap.get(processKey).stream().map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> inFlowPool.contains(item.getAdjustInPoolUuid())).collect(Collectors.toList());
failedResult.addAll(insertPoolData);
}
}
//无流程 直接入池
try {
List<String> inNonPoolId = poolAttributes.stream().filter(item -> inSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_CLOSE.equals(item.getManualInApproveSwitch())).map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> inNonPoolId.contains(item.getAdjustInPoolUuid())).collect(Collectors.toList());
if (CollectionUtils.isNotEmpty(insertPoolData)) {
List<PoolAdjustResultVO> poolAdjustResultVOS = this.copyData(insertPoolData, null, poolFlowParamVo.getAdjustFlowInitiator());
saveInstPoolAdjust(null, poolAdjustResultVOS, poolFlowParamVo.getAdjustFlowInitiator());
}
} catch (Exception e) {
log.error("无流程入池失败：" + e.getMessage());
List<String> inNonPoolId = poolAttributes.stream().filter(item -> inSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_CLOSE.equals(item.getManualInApproveSwitch())).map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> inNonPoolId.contains(item.getAdjustInPoolUuid())).collect(Collectors.toList());
failedResult.addAll(insertPoolData);
}
}
//调出 分为有流程和无流程
if (CollectionUtils.isNotEmpty(outSet)) {
//有流程
List<PoolAttribute> outAttribute = poolAttributes.stream().filter(item -> outSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_OPEN.equals(item.getManualOutApproveSwitch())).collect(Collectors.toList());
Map<String, List<PoolAttribute>> outFlowMap = outAttribute.stream().collect(Collectors.groupingBy(PoolAttribute::getManualOutApproveFlowId));
Set<String> keySet = outFlowMap.keySet();
for (String processKey : keySet) {
try {
List<String> outFlowPool = outFlowMap.get(processKey).stream().map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> outFlowPool.contains(item.getAdjustOutPoolUuid())).collect(Collectors.toList());
Map<String, Object> map = new HashMap<>();
//map.put("hsBpmInstanceDesc", hsBpmInstanceDesc);
Map<String, String> mapScr = new HashMap<>();
mapScr.put("scr_name", "");
mapScr.put("ins_fn", poolFlowParamVo.getInsFn());
map.put("hsBpmInstanceExt", JSON.toJSONString(mapScr));
map.put("hsBpmRemark", aprvEvt);
map.put(WorkflowConstants.SUBMIT_USER, poolFlowParamVo.getAdjustFlowInitiator());
TSysUserBean tSysUserBean = new TSysUserBean();
tSysUserBean.setUserId(poolFlowParamVo.getAdjustFlowInitiator());
UserInfoBean userInfo = iUserService.getUserInfo(tSysUserBean);
if (Objects.nonNull(userInfo)) {
map.put(WorkflowConstants.SUBMIT_USER_ROLE, Joiner.on(Constants.SPLIT_TYPE).join(userInfo.getUserRoleList()
.stream().map(TSysRoleUser::getRoleCode).collect(Collectors.toSet())));
}
String outcome = null;
// 根据客户号进行不同处理
String custNum = configForCommService.getCustomNum().getResult();
if (Constants.FTS_CUSTNUM.equals(custNum)) {
outcome = "submit";
}
String instanceId = instanceService.startWithSubmit(systemId, companyId, adjustFlowInitiator, processKey, null, outcome, map, null);
//poolFlowParamVo 转化 PoolAdjustResultVO
PoolFlowParamVo outFlowParamVo = new PoolFlowParamVo();
for (PoolContentInsertVo insertPoolDatum : insertPoolData) {
insertPoolDatum.setFlowInstNo(instanceId);
}
outFlowParamVo.setAdjustFlowInitiator(poolFlowParamVo.getAdjustFlowInitiator());
outFlowParamVo.setPoolContentInsertVos(insertPoolData);
submitOutInstProcess(outFlowParamVo);
Long taskId = taskService.getLastTaskByInstanceId(systemId, companyId, instanceId);
SuccessFlowInfo successFlowInfo = new SuccessFlowInfo();
successFlowInfo.setFlowInstNo(instanceId);
successFlowInfo.setTaskNum(taskId.toString());
successFlowInfos.add(successFlowInfo);
outFlowParamVo.setAprvEvt(poolFlowParamVo.getAprvEvt());
// 机构池
String nodeId = Constants.SUBJECT_OUT_START_NODE;
// 根据客户号进行不同处理
if (Constants.FTS_CUSTNUM.equals(custNum)) {
if (Constants.SUBJECT_IN_OUT_NODE_FTS_MAP.keySet().contains(processKey)) {
nodeId = Constants.SUBJECT_IN_OUT_NODE_FTS_MAP.get(processKey);
}
}
String startJson = this.buildInstOutPoolStartPage(outFlowParamVo);
ratForCommService.saveTaskConentForComp(instanceId, taskId.toString(), startJson, nodeId);
} catch (Exception e) {
log.error("调出流程发起失败", e);
List<String> outFlowPool = outFlowMap.get(processKey).stream().map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> outFlowPool.contains(item.getAdjustOutPoolUuid())).collect(Collectors.toList());
failedResult.addAll(insertPoolData);
}
}
//无流程 直接出池
try {
List<String> outNonPoolId = poolAttributes.stream().filter(item -> outSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_CLOSE.equals(item.getManualOutApproveSwitch())).map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> outNonPoolId.contains(item.getAdjustOutPoolUuid())).collect(Collectors.toList());
PoolFlowParamVo outFlowParamVo = new PoolFlowParamVo();
outFlowParamVo.setAdjustFlowInitiator(poolFlowParamVo.getAdjustFlowInitiator());
outFlowParamVo.setPoolContentInsertVos(insertPoolData);
endOutInstProcess(outFlowParamVo);
} catch (Exception e) {
log.error("无流程出池失败：" + e.getMessage());
List<String> outNonPoolId = poolAttributes.stream().filter(item -> outSet.contains(item.getPoolUuid()) && Constants.FLOW_FLAG_CLOSE.equals(item.getManualOutApproveSwitch())).map(item -> item.getPoolUuid()).collect(Collectors.toList());
List<PoolContentInsertVo> insertPoolData = poolContentInsertVos.stream().filter(item -> outNonPoolId.contains(item.getAdjustOutPoolUuid())).collect(Collectors.toList());
failedResult.addAll(insertPoolData);
}
}
poolFlowStartResultVo.setFailedItem(failedResult);
poolFlowStartResultVo.setSuccessTask(successFlowInfos);
return CommUtil.buildRpcResultDTO(poolFlowStartResultVo);
}